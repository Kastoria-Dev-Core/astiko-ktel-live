# Upstash Redis: the same store as astiko-ktel-announcements
# (Vercel dashboard -> Storage -> the store -> Connect Project). Added to the
# project's env vars as KV_REST_API_URL / KV_REST_API_TOKEN; the UPSTASH_ names also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The keys the drivers' phones may send with, comma-separated: one per phone, or
# one for all. Typed into each phone's setup as "Κλειδί συσκευής".
DEVICE_KEYS=
